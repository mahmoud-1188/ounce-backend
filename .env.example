# انسخ هذا الملف إلى .env محليًا، أو أدخل نفس القيم كـ Environment
# Variables في لوحة تحكم Railway عند النشر.

# رابط اتصال Postgres — من Supabase: Project Settings > Database >
# Connection string > "Transaction" mode (يدعم اتصالات كثيرة قصيرة العمر،
# مناسب لطبيعة withBranch/withoutBranch في db.js).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# مفتاح توقيع JWT — يجب أن يكون طويلًا وعشوائيًا في الإنتاج، لا القيمة
# التطويرية الافتراضية.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

JWT_EXPIRES_IN=12h

# مفتاح مؤقت لإنشاء أول حساب owner لمتجر (POST /api/store-auth/bootstrap-owner)
# — طويلٌ وعشوائيٌ في الإنتاج، ويُحذف هذا المسار نهائيًا فور بناء لوحة
# تحكّم أدمن حقيقية — لا يُترك مفعّلًا في الإنتاج طويلًا.
PLATFORM_ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Railway يضبط PORT تلقائيًا — هذه القيمة تُستخدم محليًا فقط.
PORT=3001

# دومين (أو أكثر مفصولة بفواصل) الفرونت إند المسموح له بمناداة هذا
# الباك إند. اتركه فارغًا محليًا (يُسمح لأي origin تلقائيًا).
CORS_ORIGIN=https://your-frontend-domain.com
