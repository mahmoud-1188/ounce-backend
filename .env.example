# انسخ هذا الملف إلى .env محليًا، أو أدخل نفس القيم كـ Environment
# Variables في لوحة تحكم Railway عند النشر.

# رابط اتصال Postgres — من Supabase: Project Settings > Database >
# Connection string > "Transaction" mode (يدعم اتصالات كثيرة قصيرة العمر،
# مناسب لطبيعة withBranch/withoutBranch في db.js).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# مفتاح توقيع JWT — يجب أن يكون طويلًا وعشوائيًا في الإنتاج، لا القيمة
# التطويرية الافتراضية.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

JWT_EXPIRES_IN=12h

# مفتاح المنصة — طويلٌ وعشوائيٌ في الإنتاج. يُستخدم مرة واحدة فقط لإنشاء
# أول حساب أدمن من لوحة ounce-admin (POST /api/platform/auth/setup)؛ بعد
# أول حساب يُرفض ذلك المسار نهائيًّا والدخول بالبريد وكلمة المرور.
PLATFORM_ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Railway يضبط PORT تلقائيًا — هذه القيمة تُستخدم محليًا فقط.
PORT=3001

# سعر الذهب من مزوّدٍ مدفوع (اختياري): goldapi أو metalpriceapi أو metalsapi، ومفتاحه.
# يُسأل أوّلًا كل دقيقة، وإن تعذّر يعود الخادم إلى gold-api.com المجاني. المفتاح هنا وحده لا في المتصفّح.
# GOLD_PRICE_PROVIDER=goldapi
# GOLD_PRICE_API_KEY=

# دومين (أو أكثر مفصولة بفواصل) الفرونت إند المسموح له بمناداة هذا
# الباك إند: الفرع + المركزي + لوحة الأدمن (ounce-admin).
# اتركه فارغًا محليًا (يُسمح لأي origin تلقائيًا).
CORS_ORIGIN=https://your-frontend-domain.com

# الذكاء الصناعي — ⚠ المفاتيح في متغيّرات Railway وحدها، لا في المستودع.
# وجود ANTHROPIC_API_KEY يكفي لتشغيل Anthropic، وبدونه يعمل DeepSeek بمفتاحه.
# AI_PROVIDER (اختياري) يثبّت المزوّد ويغلب المفاتيح: anthropic أو deepseek.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# AI_PROVIDER=deepseek
# اختياري: موديل المساعد المحاسبي، وموديل المحادثة، وموديل مساعد الإدارة
# AI_MODEL=claude-sonnet-5-5
# AI_CHAT_MODEL=claude-haiku-5-5
# AI_HQ_MODEL=claude-sonnet-5-5
